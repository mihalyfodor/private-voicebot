OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=omlx
OMLX_MODEL=gemma-4-26b
PORT=8010
AVATAR=wanko            # wanko | haru
# KOKORO_VOICE / KOKORO_SPEED override the avatar's default voice

# Context budget, reply length (defaults shown)
# CONTEXT_BUDGET=16000     # token budget for the conversation, capped further by the model's max_model_len
# MAX_TOKENS=0             # reply token ceiling; 0 = derive from verbosity (400 short/normal, 800 long)
# VERBOSITY=normal         # short | normal | long — overridden by settings.json, falls back to card default
# MEMORY_LINES=60          # number of trailing lines of shortmem.txt injected into the system prompt

# Hands-free / speech recognition (defaults shown)
# WHISPER_MLX_MODEL=mlx-community/whisper-small-mlx
# VAD_THRESHOLD=0.5
# VAD_END_SILENCE_MS=700
# VAD_MIN_SPEECH_MS=300
# VAD_PRE_ROLL_MS=300
# VAD_MAX_UTTERANCE_S=30
