# Copy to .env — chatbot.py loads it on start. Every variable the code reads, with its default.

# --- LLM (oMLX, OpenAI-compatible) ---------------------------------------------------
OMLX_BASE_URL=http://localhost:8000/v1
OMLX_API_KEY=omlx
OMLX_MODEL=gemma-4-26b
# CONTEXT_BUDGET=16000     # token budget for the conversation, capped further by the model's max_model_len
# MAX_TOKENS=0             # reply token ceiling; 0 = derive from verbosity (400 short/normal, 800 long)
# VERBOSITY=normal         # short | normal | long — overridden by settings.json, falls back to card default
# OMLX_ADMIN_PASSWORD=     # oMLX admin password for model load/unload; wins over the settings.json value

# --- Server ---------------------------------------------------------------------------
PORT=8011                  # dev checkout; the prod container owns 8010
# HOST=127.0.0.1           # loopback by default; 0.0.0.0 exposes the app on the LAN
OPEN_BROWSER=1             # 0 = start the server without opening a browser tab
# ALLOWED_ORIGINS=         # comma list of extra browser origins accepted next to http://localhost:PORT
# DEV_PORT=8011            # dev port; with PROD_PORT feeds running_app() (core/util.py), the "app is running" guard of reindex and batch ingest
# PROD_PORT=8010           # prod port: the compose mapping (scripts/prod.sh) and the running_app() guard; the origin check uses PORT + ALLOWED_ORIGINS
# START_HINT=scripts/voicebot start   # command shown in the 'LLM offline' message
# IDLE_SAVE_MIN=10         # minutes of idle before the session is folded into memory
# VOICEBOT_VERSION=        # build version shown in /api/config (set by prod.sh deploy via the image build arg); unset falls back to `git describe`

# --- Avatar / voice (Kokoro TTS) --------------------------------------------------------
# AVATAR=wanko             # wanko is the only avatar; unknown keys fall back to it
# KOKORO_MODEL=~/models/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES=~/models/kokoro/voices-v1.0.bin
# KOKORO_VOICE=            # override the avatar's default voice (e.g. af_bella)
# KOKORO_SPEED=            # override the avatar's default speed (float)

# --- Speech recognition / hands-free ------------------------------------------------------
# WHISPER_MLX_MODEL=mlx-community/whisper-small-mlx
# ASR_BACKEND=mlx          # mlx = in-process mlx-whisper; remote = POST to the host ASR service (scripts/asr_server.py)
# ASR_URL=http://127.0.0.1:8020
# VAD_THRESHOLD=0.5
# VAD_END_SILENCE_MS=700
# VAD_MIN_SPEECH_MS=300
# VAD_PRE_ROLL_MS=300
# VAD_MAX_UTTERANCE_S=30
# ASR_HOST=127.0.0.1       # scripts/asr_server.py bind address
# ASR_PORT=8020            # scripts/asr_server.py bind port

# --- Memory (memory.json) ----------------------------------------------------------------
# MEMORY_SAVE_EVERY=5        # fold the session into memory every N completed turns
# MEMORY_REFLECT_EVERY=5     # run the profile reflection/cleanup pass every N saves
# MEMORY_BUDGET_TOKENS=700   # token budget for the <user_profile> block in the system prompt
# MEMORY_STALE_PEOPLE=180    # days without a mention before a person entry is marked stale
# MEMORY_STALE_PROJECTS=120
# MEMORY_STALE_RECURRING=90

# --- Wiki / sources (the vault) ------------------------------------------------------------
# WIKI_PATH=~/llm-wiki-dev   # the Obsidian vault the wiki tab edits and ingests into (code default, core/config.py); prod sets it explicitly in compose (~/.voicebot/data/llm-wiki)
# WIKI_INDEX_TOKENS=600      # token budget for the wiki index in the system prompt
# RAW_CHUNK_TOKENS=6000      # chunk size when ingesting a source document
# WIKI_RELATED_TOKENS=200    # token budget for the related-pages block per recalled page

# --- reMarkable (host services: scripts/remarkable_server.py push, scripts/remarkable_sync.py pull) ---
# REMARKABLE_PUSH_URL=       # push service URL the app posts to; unset = the push command is off
# REMARKABLE_PORT=8021       # push service listen port (127.0.0.1)
# REMARKABLE_URL=http://10.11.99.1   # the tablet's USB web interface
# REMARKABLE_FOLDER=wiki-inbox       # tablet folder the sync reads notebooks from
# REMARKABLE_OCR=1           # 0 = skip the OCR step in the sync
# REMARKABLE_OCR_BIN=        # OCR binary (default: scripts/vision_ocr)
# VOICEBOT_URL=http://127.0.0.1:8010 # app the sync uploads notebooks to

# --- Weather tool -------------------------------------------------------------------------
# LOCATION_NAME=Seychelles
# LOCATION_LAT=-4.6796
# LOCATION_LON=55.4920
# LOCATION_TIMEZONE=Indian/Mahe

# --- Wikipedia tool -----------------------------------------------------------------------
# WIKIPEDIA_CONTACT=         # optional contact (email or URL) appended to the User-Agent, as Wikimedia asks

# --- State paths (tests, e2e, the Docker prod) ------------------------------------------------
# Every state file has a knob so nothing is written next to the code. The Docker prod (docs/deploy.md)
# keeps them all under one folder, ~/.voicebot/data/:
#   llm-wiki/  WIKI_PATH     memory/  MEMORY_DIR     settings.json  SETTINGS_PATH
#   secrets/   GMAIL_DIR     logs/    TRACE_DIR      .env           (this file)
# DATA=                      # prod data root (~/.voicebot/data), set by prod.sh/compose; read via core/trace.DATA_VARS
# SETTINGS_PATH=             # where settings.json lives (default: next to chatbot.py)
# MEMORY_DIR=                # directory for memory.json / memory_ops.jsonl / shortmem.txt (default: repo root)
# GMAIL_DIR=                 # directory holding credentials.json / token.json (default: working directory)
# TRACE_DIR=                 # events.jsonl (+ verbose.jsonl in dev) (default: logs/ in the checkout; PRD 49)
# TRACE_PROFILE=dev          # prod | dev; dev refuses to start against ~/.voicebot

# Test knobs (read by tests/scripts only, not the app): E2E_KEEP=1 keeps the e2e temp dir; E2E_TRACE_DIR is set
# by scripts/smoke.py; GOLDEN_UPDATE=1 rewrites golden files; DOCKER_KEEP_IMAGE / DOCKER_TEST_PORT tune tests/prod/test_docker.py.
# E2E_KEEP=
